{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aria-receptionist",
  "account_id": "5e87d22b2ad04838a0a7caf69b6c27dc",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BETTER_AUTH_URL": "https://aria-receptionist.aria-desk.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aria-receptionist-db",
      "database_id": "10112354-8eb4-4bd7-a9f9-3c8fe02d3285",
      "migrations_dir": "drizzle",
    },
  ],
}
